# Google PageSpeed Insights (key recommended for automated use; PSI can run without one)
GOOGLE_PSI_API_KEY=

# Chrome UX Report field data (requires a Google Cloud API key with CrUX API enabled)
GOOGLE_CRUX_API_KEY=

# Legacy SecurityHeaders.com API access. New subscriptions are currently unavailable.
SECURITY_HEADERS_API_KEY=

# Paid AI visibility integrations. Calls require --enable-paid-apis.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OTTERLY_API_KEY=

# Optional read-only Google Search Console service-account integration
GOOGLE_APPLICATION_CREDENTIALS=
GSC_PROPERTY_URL=
